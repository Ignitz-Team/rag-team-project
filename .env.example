# Supabase Postgres connection string. Use the pooled/Supavisor "transaction
# mode" connection string (port 6543), not the direct connection — it works
# for both local dev and serverless deployments.
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Secret used to sign session cookies (HS256 JWT) — required, the app won't
# start auth routes without it. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used for sending OTP emails during login/registration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Groq is used for chat answer generation. The embedding model
# (Xenova/all-MiniLM-L6-v2) runs locally and needs no API key.
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
